# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend CORS Origin (comma-separated if multiple origins)
CLIENT_URL=https://6adb4a94270b2cf54d433fe4--hostel-outpass-management.netlify.app

# Database Configuration
# In production (Render): set MONGODB_URI to your MongoDB Atlas connection string and set USE_MEMORY_DB=false
# In development: leave blank or set USE_MEMORY_DB=true for local embedded MongoDB
MONGODB_URI=
USE_MEMORY_DB=true

# Security Secrets
JWT_SECRET=replace_with_a_long_random_secret

# Business Policy Configurations
DEFAULT_GRACE_MINUTES=15
REMINDER_WINDOW_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
